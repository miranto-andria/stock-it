QPushButton {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 9px 16px;
}
QPushButton:hover {
    background-color: #f3f5f7;
}
QPushButton:pressed {
    background-color: #e9edf2;
}
QPushButton:disabled {
    color: #abadae;
    border-color: #eef0f3;
    background-color: #fafafa;
}


QPushButton#btnSearch {
    background-color: #774cff;
    border-color: #774cff;
    color: #ffffff;
    font-weight: bold;
    padding: 8px 16px;
}
QPushButton#btnSearch:hover {
    background-color: #6243FF;
    border-color: #6243FF;
}

#sideBar QPushButton:hover{
background-color: #774cff;
}

QPushButton[primaire="true"] {
    background-color: #774cff;
    color: #ffffff;
    border-color: #774cff;
    font-weight: bold;
    padding: 10px 18px;
}
QPushButton[primaire="true"]:hover {
    background-color: #6b45e8;
    border-color: #6b45e8;
}


#stockWidget QPushButton#btnSearch {
    min-width: 99px;
}

QPushButton#btn_pdf {
    min-width: 123px;
}

QMessageBox QPushButton {
    min-width: 72px;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #e5e7eb;
    border-radius: 7px;
    padding: 8px;
}

QLineEdit:focus,
QComboBox:focus {
    border-color: #2d66e4;
}

QTableWidget{
    background-color: white;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    alternate-background-color: #f8f8f8;
    gridline-color: #eef0f3;
    selection-background-color: #2d66e4;
    selection-color: #ffffff;
    outline: none;
    padding: 4px;
    show-decoration-selected: 1;
}

QTableWidget::item {
    padding: 6px 8px;
    border: none;
}

QTableWidget::item:hover {
    background-color: rgba(45, 102, 228, 10%);
    color: #111827;
}

QTableWidget::item:selected {
    background-color: #2d66e4;
    color: #ffffff;
}


QHeaderView {
    background-color: #774cff;
    border: none;
}

QHeaderView::section {
    background-color: #774cff;
    color: #f8f8ff;

    padding: 6px 0px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 40%);

    font-weight: 600;
}

QTableCornerButton::section {
    background-color: #f5f7f9;
    border: none;
}

QScrollBar:vertical {
    background-color: #f5f7f9;
    width: 8px;
    margin: 4px 2px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #c3c8d1;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #2d66e4;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}


QScrollBar:horizontal {
    background-color: #f5f7f9;
    height: 8px;
    margin: 2px 4px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #c3c8d1;
    border-radius: 4px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #2d66e4;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

#carte_produits, #carte_stock, #carte_entrees, #carte_sorties {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
}
#cadre_histogramme, #cadre_camembert {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
}
QLabel#tile_ico_produits, QLabel#tile_ico_stock,
QLabel#tile_ico_entrees, QLabel#tile_ico_sorties {
    background: #ecf3fe;
    border-radius: 10px;
}
QLabel#titre_produits, QLabel#titre_stock,
QLabel#titre_entrees, QLabel#titre_sorties {
    font-weight: bold; color: #374151;
}
QLabel#valeur_produits, QLabel#valeur_stock,
QLabel#valeur_entrees, QLabel#valeur_sorties {
    font-size: 23px; font-weight: bold; color: #111827;
}

QFrame#frame {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
}
QGroupBox {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    margin-top: 14px;
    padding: 10px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #111827;
}
#bloc_mouvements QListWidget {
    background: #ffffff;
    color: #111827;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
}
