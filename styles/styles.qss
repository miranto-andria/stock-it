QWidget {
    font-family: "Montserrat", "Segoe UI", sans-serif;
    color: #111827;
}
QMainWindow, QDialog, QMessageBox {
    background: #ffffff;
}
QStackedWidget, QScrollArea {
    background: #f5f7f9;
}

#sideBar QPushButton {
    text-align: left;
    border: none;
    margin: 2px 10px;
    padding: 11px 14px;
    border-radius: 8px;
    font-size: 10.5pt;
    background-color: transparent;
    color: #ffffff;
}
#sideBar QPushButton:hover {
    background-color: rgba(255,255,255,0.15);
    color: #ffffff;
}

#carte_produits, #carte_stock, #carte_entrees, #carte_sorties {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
}
#cadre_histogramme, #cadre_camembert {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
}
QLabel#tile_ico_produits, QLabel#tile_ico_stock,
QLabel#tile_ico_entrees, QLabel#tile_ico_sorties {
    background: #e8effc;
    border-radius: 10px;
}
QLabel#titre_produits, QLabel#titre_stock,
QLabel#titre_entrees, QLabel#titre_sorties {
    font-weight: bold;
    color: #374151;
}
QLabel#valeur_produits, QLabel#valeur_stock,
QLabel#valeur_entrees, QLabel#valeur_sorties {
    font-size: 20pt;
    font-weight: bold;
    color: #111827;
}
QLabel#sous_produits, QLabel#sous_stock,
QLabel#sous_entrees, QLabel#sous_sorties {
    color: #6b7280;
}

QGroupBox {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    margin-top: 14px;
    padding: 10px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #2d66e4;
}

QTableWidget {
    background: #ffffff;
    alternate-background-color: #f8f8f8;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    gridline-color: #eef0f3;
    selection-background-color: #e8effc;
    selection-color: #111827;
    outline: none;
}
QHeaderView::section {
    background: rgba(45, 102, 228, 0.08);
    color: #2d66e4;
    padding: 8px 4px;
    border: none;
    border-bottom: 1px solid #dfe7f7;
    font-weight: bold;
}
QTableWidget::item {
    padding: 6px 8px;
}
QTableWidget::item:selected {
    background: #e8effc;
    color: #111827;
}
QTableCornerButton::section {
    background: #f5f7f9;
    border: none;
}

QPushButton {
    background: #ffffff;
    border: 1px solid #d5dbe3;
    border-radius: 8px;
    padding: 7px 14px;
    color: #374151;
}
QPushButton:hover {
    background: #f5f7f9;
    border-color: #abadae;
    color: #111827;
}
QPushButton:pressed {
    background: #eef0f3;
}
QPushButton:focus {
    border: 1px solid #2d66e4;
}
QPushButton:disabled {
    color: #abadae;
    background: #f8f8f8;
    border-color: #e5e7eb;
}

QPushButton[primaire="true"] {
    background: #2d66e4;
    color: #ffffff;
    border: 1px solid #2d66e4;
    font-weight: bold;
}
QPushButton[primaire="true"]:hover {
    background: #2456c6;
}
QPushButton[primaire="true"]:pressed {
    background: #1c46a5;
}

QPushButton[accent="true"] {
    background: #774cff;
    color: #ffffff;
    border: 1px solid #774cff;
    font-weight: bold;
}
QPushButton[accent="true"]:hover {
    background: #6539eb;
}
QPushButton[accent="true"]:pressed {
    background: #5530d6;
}

QPushButton[danger="true"] {
    background: #ffffff;
    color: #b91c1c;
    border: 1px solid #fca5a5;
    font-weight: bold;
}
QPushButton[danger="true"]:hover {
    background: #fef2f2;
}

QPushButton[primaire="true"]:disabled,
QPushButton[accent="true"]:disabled,
QPushButton[danger="true"]:disabled {
    background: #f8f8f8;
    color: #abadae;
    border: 1px solid #e5e7eb;
}

QPushButton#btnSearch {
    background: #774cff;
    color: #ffffff;
    border: 1px solid #774cff;
    font-weight: bold;
    padding: 8px 16px;
}
QPushButton#btnSearch:hover {
    background: #6539eb;
    border-color: #6539eb;
}
QMessageBox QPushButton {
    min-width: 72px;
}
QDialogButtonBox QPushButton {
    min-width: 84px;
}
QPushButton#btn_pdf {
    min-width: 123px;
}
#stockWidget QPushButton#btnSearch {
    min-width: 99px;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #ffffff;
    border: 1px solid #d5dbe3;
    border-radius: 8px;
    padding: 6px 8px;
    selection-background-color: #2d66e4;
    selection-color: #ffffff;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #2d66e4;
    background: #ffffff;
}
QLineEdit:disabled, QComboBox:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled {
    background: #f8f8f8;
    color: #abadae;
    border: 1px solid #e5e7eb;
}
QComboBox::drop-down {
    border-left: 1px solid #eef0f3;
    width: 22px;
}

QMenu {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    padding: 4px;
}
QMenu::item {
    padding: 5px 18px;
    border-radius: 6px;
}
QMenu::item:selected {
    background: #f5f7f9;
    color: #2d66e4;
}

QListWidget {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    outline: none;
}
QListWidget::item {
    padding: 4px 8px;
    border-radius: 6px;
}
QListWidget::item:selected {
    background: #e8effc;
    color: #111827;
}
#derniers_mouvements {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 9pt;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #ffffff;
}

QTabWidget::pane {
    border: 1px solid #e5e7eb;
    background: #ffffff;
    border-radius: 8px;
    top: -1px;
}
QTabBar::tab {
    background: #f8f8f8;
    color: #6b7280;
    padding: 8px 16px;
    border: 1px solid #e5e7eb;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
QTabBar::tab:selected {
    background: #2d66e4;
    color: #ffffff;
    font-weight: bold;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    border: none;
}
QScrollBar:vertical {
    width: 10px;
}
QScrollBar:horizontal {
    height: 10px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #d5dbe3;
    border-radius: 5px;
    min-height: 30px;
    min-width: 30px;
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #abadae;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}
QToolTip {
    background: #111827;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 9pt;
}
