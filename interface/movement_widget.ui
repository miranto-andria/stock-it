#MovementWidget #periode { color: #2d66e4; font-size: 9pt; font-weight: 700; }
#MovementWidget QDateEdit { background: #ffffff; border: 1px solid #d5dbe3; border-radius: 8px; padding: 6px 8px; }
#MovementWidget QDateEdit:focus { border-color: #2d66e4; }
#MovementWidget QDateEdit:disabled { background: #f8f8f8; color: #abadae; border-color: #e5e7eb; }
#MovementWidget QTableWidget { border-radius: 10px; font-size: 9.5pt; }
#MovementWidget QHeaderView::section { padding: 10px 8px; font-size: 9pt; }
#MovementWidget #resume { background: #ffffff; border: 1px solid #dfe7f7; border-radius: 10px; color: #374151; font-size: 10pt; font-weight: 600; padding: 11px 14px; }</string>
