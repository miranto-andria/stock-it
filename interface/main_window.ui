}

QWidget {
    font-family: &quot;Montserrat&quot;, &quot;Segoe UI&quot;, sans-serif;
    color: #111827;
}
QMainWindow, QDialog, QMessageBox {
    background: #f5f7f9;
}
QStackedWidget, QScrollArea {
    background: #f5f7f9;
}

QGroupBox {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    margin-top: 14px;
    padding: 10px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #2d66e4;
}

QTableWidget {
    background: #ffffff;
    alternate-background-color: #f8f8f8;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    gridline-color: #eef0f3;
    selection-background-color: #e8effc;
    selection-color: #111827;
    outline: none;
}
QHeaderView::section {
    background: rgba(45, 102, 228, 0.08);
    color: #2d66e4;
    padding: 8px 4px;
    border: none;
    border-bottom: 1px solid #dfe7f7;
    font-weight: bold;
}
QTableWidget::item {
    padding: 6px 8px;
}
QTableWidget::item:selected {
    background: #e8effc;
    color: #111827;
}
QTableCornerButton::section {
    background: #f5f7f9;
    border: none;
}

QPushButton {
    border-radius: 8px;
    padding: 7px 14px;
}
QPushButton:hover {
    background: #f5f7f9;
    border-color: #abadae;

    color: #111827;
}
QPushButton:pressed {
    background: #eef0f3;
}
QPushButton:focus {
    border: 1px solid #2d66e4;
}
QPushButton:disabled {
    color: #abadae;
    background: #f8f8f8;
    border-color: #e5e7eb;
}

QPushButton[primaire=&quot;true&quot;] {
    background: #2d66e4;
    color: #ffffff;
    border: 1px solid #2d66e4;
    font-weight: bold;
}
QPushButton[primaire=&quot;true&quot;]:hover {
    background: #2456c6;
}
QPushButton[primaire=&quot;true&quot;]:pressed {
    background: #1c46a5;
}

QPushButton[accent=&quot;true&quot;] {
    background: #2d66e4;
    color: #ffffff;
    border: 1px solid #2d66e4;
    font-weight: bold;
}
QPushButton[accent=&quot;true&quot;]:hover {
    background: #2456c6;
}
QPushButton[accent=&quot;true&quot;]:pressed {
    background: #1c46a5;
}

QPushButton[danger=&quot;true&quot;] {
    background: #dc4a4a;
    color: #ffffff;
    border: 1px solid #dc4a4a;
    font-weight: bold;
}
QPushButton[danger=&quot;true&quot;]:hover {
    background: #c83d3d;
    border-color: #c83d3d;
}
QPushButton[danger=&quot;true&quot;]:pressed {
    background: #ad3030;
    border-color: #ad3030;
}

QPushButton[success=&quot;true&quot;] {
    background: #15803d;
    color: #ffffff;
    border: 1px solid #15803d;
    font-weight: bold;
}
QPushButton[success=&quot;true&quot;]:hover {
    background: #126b34;
}

QPushButton[secondary=&quot;true&quot;] {
    background: #ffffff;
    color: #374151;
    border: 1px solid #d5dbe3;
    font-weight: 600;
}
QPushButton[secondary=&quot;true&quot;]:hover {
    background: #eef3fb;
    border-color: #b8c7df;
}

QPushButton[primaire=&quot;true&quot;]:disabled,
QPushButton[accent=&quot;true&quot;]:disabled,
QPushButton[danger=&quot;true&quot;]:disabled {
    background: #f8f8f8;
    color: #abadae;
    border: 1px solid #e5e7eb;
}
QPushButton[success=&quot;true&quot;]:disabled,
QPushButton[secondary=&quot;true&quot;]:disabled {
    background: #f1f3f5;
    color: #9ca3af;
    border: 1px solid #e5e7eb;
}

QPushButton#btnSearch {
    background: #0d6efd;
    color: #ffffff;
    border: 1px solid #0d6efd;
    font-weight: bold;
    padding: 8px 16px;
}
QPushButton#btnSearch:hover {
    background: #0b5ed7;
    border-color: #0b5ed7;
}

QMessageBox QPushButton {
    min-width: 72px;
}
QDialogButtonBox QPushButton {
    min-width: 84px;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #ffffff;
    border: 1px solid #d5dbe3;
    border-radius: 8px;
    padding: 6px 8px;
    selection-background-color: #2d66e4;
    selection-color: #ffffff;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #2d66e4;
    background: #ffffff;
}
QLineEdit:disabled, QComboBox:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled {
    background: #f8f8f8;
    color: #abadae;
    border: 1px solid #e5e7eb;
}
QComboBox::drop-down {
    border-left: 1px solid #eef0f3;
    width: 22px;
}

QMenu {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    padding: 4px;
}
QMenu::item {
    padding: 5px 18px;
    border-radius: 6px;
}
QMenu::item:selected {
    background: #f5f7f9;
    color: #2d66e4;
}

QListWidget {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    outline: none;
}
QListWidget::item {
    padding: 4px 8px;
    border-radius: 6px;
}
QListWidget::item:selected {
    background: #e8effc;
    color: #111827;
}

QTabWidget::pane {
    border: 1px solid #e5e7eb;
    background: #ffffff;
    border-radius: 8px;
    top: -1px;
}
QTabBar::tab {
    background: #f8f8f8;
    color: #6b7280;
    padding: 8px 16px;
    border: 1px solid #e5e7eb;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
QTabBar::tab:selected {
    background: #2d66e4;
    color: #ffffff;
    font-weight: bold;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    border: none;
}
QScrollBar:vertical {
    width: 10px;
}
QScrollBar:horizontal {
    height: 10px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #d5dbe3;
    border-radius: 5px;
    min-height: 30px;
    min-width: 30px;
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #abadae;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}
